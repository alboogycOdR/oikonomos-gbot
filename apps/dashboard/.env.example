# Local development only. Values here are public Firebase Web SDK client
# identifiers (project basileia-oikonomos-gmail) — not secrets; see
# lib/firebase.ts's doc comment for why. Get real values from Firebase
# Console -> Project settings -> your Web app -> SDK setup and
# configuration, or `firebase apps:sdkconfig WEB <app-id> --project
# basileia-oikonomos-gmail` (needs `firebase login` first). Do not commit
# a real .env with these filled in — .env is gitignored, this file is the
# template.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Overrides same-origin control-api base URL for local dev against a
# separate control-api process (TASK-102/E9.1a, api.ts).
VITE_CONTROL_API_BASE_URL=
